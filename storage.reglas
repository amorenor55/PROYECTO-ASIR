rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function orden(id) {
      return firestore.get(/databases/(default)/documents/ordenes/$(id)).data;
    }
    function editor() {
      return request.auth != null && perfil().activo == true
        && perfil().perfil in ['ADMINISTRACION', 'RECEPCION'];
    }
    function vinculado(datos, archivo) {
      let lista = datos.get('documentos', []);
      return (lista.size() > 0 && lista[0].get('archivoId', '') + '.pdf' == archivo)
        || (lista.size() > 1 && lista[1].get('archivoId', '') + '.pdf' == archivo);
    }
    function puedeVerFotos(ordenId) {
      return request.auth != null && perfil().activo == true
        && firestore.exists(/databases/(default)/documents/ordenes/$(ordenId))
        && (editor() || (perfil().perfil == 'MECANICO'
          && orden(ordenId).mecanicoId == request.auth.uid));
    }
    function puedeEditarFotos(ordenId) {
      return puedeVerFotos(ordenId) && orden(ordenId).estado != 'Finalizado';
    }
    match /fotos/{ordenId} {
      match /{prefijo=**} {
        allow list: if puedeVerFotos(ordenId);
      }
      match /{archivo} {
        allow get: if puedeVerFotos(ordenId);
        allow create: if puedeEditarFotos(ordenId)
          && archivo.matches('^(entrada|salida|danos|recambios|otros)_[a-f0-9-]{36}[.](jpg|png|webp)$')
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
          && request.resource.size > 0 && request.resource.size <= 10485760;
        allow delete: if puedeEditarFotos(ordenId);
      }
    }
    match /adjuntos/{ordenId}/{archivo} {
      allow get: if request.auth != null && perfil().activo == true
        && (editor() || (perfil().perfil == 'MECANICO'
          && orden(ordenId).mecanicoId == request.auth.uid))
        && vinculado(orden(ordenId), archivo);
      allow create: if editor() && orden(ordenId).estado != 'Finalizado'
        && archivo.matches('^[a-f0-9-]{36}[.]pdf$')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0 && request.resource.size <= 20971520;
      allow delete: if editor() && !vinculado(orden(ordenId), archivo);
    }
  }
}
